# ============================================================
# VOGT HIGH TECH — Digital Campus — variables d'environnement
# Copier en .env et renseigner les vraies valeurs.
# Ne jamais committer le fichier .env reel.
# ============================================================

SERVER_PORT=8080

# Base de donnees
DB_URL=jdbc:postgresql://localhost:5432/vogt_digital_campus
DB_USER=vogt
DB_PASSWORD=change_me
DDL_AUTO=update
SHOW_SQL=false

# Kafka
KAFKA_BROKERS=localhost:9092

# JWT — generer un secret aleatoire d'au moins 32 caracteres
JWT_SECRET=change_me_generate_a_real_secret_min_32_chars
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# CORS — domaines autorises (front Next.js / React), separes par des virgules
CORS_ORIGINS=http://localhost:3000

# Candidatures
APPLICATION_PREFIX=VHT

# URL publique du backend lui-meme (OBLIGATOIRE en production avec le stockage
# local) — sans elle, les images uploadees (galerie, logos partenaires...) sont
# invisibles depuis le frontend Netlify. Exemple : https://vogt-backend.onrender.com
PUBLIC_BASE_URL=

# Stockage objet (documents candidats, photos, galerie) — S3-compatible
# Laisser STORAGE_PROVIDER=local pour tester sans rien configurer (fichiers
# ecrits sur le disque du serveur — non persistant sur Render entre deploiements).
# Passer a "s3-compatible" + renseigner les 4 valeurs suivantes pour un vrai
# stockage (Cloudflare R2, AWS S3, Supabase Storage...).
STORAGE_PROVIDER=local
STORAGE_BUCKET=vogt-documents
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=auto
STORAGE_PUBLIC_BASE_URL=
STORAGE_LOCAL_PATH=./storage

# Email (notifications candidature) — desactive tant que MAIL_ENABLED=false
# (les emails sont alors seulement journalises). Fonctionne avec n'importe
# quel fournisseur SMTP (Gmail, SendGrid, Mailgun, SMTP institutionnel...).
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@vogthightech.cm

# Notifications push (vraies notifications type téléphone) — générer une paire
# de clés VAPID (ex. `npx web-push generate-vapid-keys`). Sans ces clés, les
# envois sont simplement journalisés, l'app démarre normalement quand même.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@vogthightech.cm

# WhatsApp (via Twilio) — désactivé tant que WHATSAPP_ENABLED=false.
WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
